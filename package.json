{
  "name": "adlane-mcp",
  "version": "1.1.0",
  "description": "Adlane MCP connector for Claude Desktop and other stdio clients",
  "type": "module",
  "bin": {
    "adlane-mcp": "server/index.js"
  },
  "files": [
    "server",
    "icon.png",
    "manifest.json",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "bundle": "mcpb pack . adlane.mcpb"
  },
  "dependencies": {
    "mcp-remote": "0.14.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Codex",
  "contributors": [
    {
      "name": "Codex"
    }
  ],
  "license": "MIT",
  "homepage": "https://adlane.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adlane-app/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/adlane-app/mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "claude",
    "desktop",
    "adlane"
  ],
  "mcpName": "io.github.adlane-app/mcp-server",
  "overrides": {
    "tmp": "^0.2.6"
  }
}
