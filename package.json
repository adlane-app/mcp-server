{
  "name": "adlane-mcp",
  "version": "2.0.0",
  "description": "Ad library search MCP connector by Adlane: see competitor ads on Meta, TikTok, LinkedIn and Google at once, save ad creative to boards and track competitors.",
  "type": "module",
  "bin": {
    "adlane-mcp": "server/index.js"
  },
  "files": [
    "server",
    "icon.png",
    "manifest.json",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "bundle": "mcpb pack . adlane.mcpb"
  },
  "dependencies": {
    "mcp-remote": "0.14.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Codex",
  "contributors": [
    {
      "name": "Codex"
    }
  ],
  "license": "MIT",
  "homepage": "https://adlane.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adlane-app/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/adlane-app/mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "adlane",
    "ad-library",
    "ad-library-search",
    "competitor-ads",
    "ad-spy",
    "ad-creative",
    "ad-intelligence",
    "meta-ad-library",
    "competitor-research"
  ],
  "mcpName": "io.github.adlane-app/mcp-server",
  "overrides": {
    "tmp": "^0.2.6"
  }
}
